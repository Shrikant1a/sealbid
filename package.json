{
  "name": "sealbid-confidential-defi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SealBid: Private Sealed-Bid Auction DApp on Midnight Network",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
